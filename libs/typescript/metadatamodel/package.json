{
  "name": "@dyn-rt/metadatamodel",
  "version": "1.0.0",
  "description": "dyn-rt metadatamodel (TS): the metadata model as an extensible JSON-like Value tree — field/group props, templated group:path_key paths, strict cardinality, plus the fieldcolumns / database / iter / filter / flattener / unflattener / groupindex subdomains. Port of libs/rust/metadatamodel.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dyn-rt/manipulation": "workspace:*",
    "@dyn-rt/path": "workspace:*",
    "@dyn-rt/reflect": "workspace:*",
    "@dyn-rt/schema": "workspace:*",
    "@dyn-rt/shared": "workspace:*"
  },
  "devDependencies": {
    "@dyn-rt/test-support": "workspace:*",
    "@types/node": "^25.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "author": "Declan Joseph <declan.obu@outlook.com>",
  "keywords": [
    "dyn-rt",
    "metadata-model",
    "flattener",
    "unflattener",
    "filter",
    "fieldcolumns",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rogonion/dyn-rt.git",
    "directory": "libs/typescript/metadatamodel"
  },
  "bugs": {
    "url": "https://github.com/rogonion/dyn-rt/issues"
  },
  "homepage": "https://github.com/rogonion/dyn-rt",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
