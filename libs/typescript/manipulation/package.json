{
  "name": "@dyn-rt/manipulation",
  "version": "1.0.0",
  "description": "dyn-rt manipulation module (ADR 0010): get / set / delete / for_each / are_equal over native values at a JSONPath, plus the DynObject entrypoint wrapper. Port of libs/rust/manipulation; TS values are references, so mutation is direct and no reflect-ceremony is needed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dyn-rt/path": "workspace:*",
    "@dyn-rt/reflect": "workspace:*",
    "@dyn-rt/schema": "workspace:*",
    "@dyn-rt/shared": "workspace:*"
  },
  "devDependencies": {
    "@dyn-rt/test-support": "workspace:*",
    "@types/node": "^25.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "author": "Declan Joseph <declan.obu@outlook.com>",
  "keywords": [
    "dyn-rt",
    "jsonpath",
    "get",
    "set",
    "delete",
    "tree-manipulation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rogonion/dyn-rt.git",
    "directory": "libs/typescript/manipulation"
  },
  "bugs": {
    "url": "https://github.com/rogonion/dyn-rt/issues"
  },
  "homepage": "https://github.com/rogonion/dyn-rt",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
