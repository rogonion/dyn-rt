{
  "name": "@dyn-rt/schema",
  "version": "1.0.0",
  "description": "dyn-rt schema module (ADR 0010): JSON-like schema trees over native values — validation, conversion, schema-path resolution. Port of libs/rust/schema; TS values are plain data, so no reflect ceremony is needed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dyn-rt/path": "workspace:*",
    "@dyn-rt/reflect": "workspace:*",
    "@dyn-rt/shared": "workspace:*"
  },
  "devDependencies": {
    "@dyn-rt/test-support": "workspace:*",
    "@types/node": "^25.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "author": "Declan Joseph <declan.obu@outlook.com>",
  "keywords": [
    "dyn-rt",
    "schema",
    "validation",
    "conversion",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rogonion/dyn-rt.git",
    "directory": "libs/typescript/schema"
  },
  "bugs": {
    "url": "https://github.com/rogonion/dyn-rt/issues"
  },
  "homepage": "https://github.com/rogonion/dyn-rt",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
