{
  "name": "@dyn-rt/dyn-rt",
  "version": "0.1.0",
  "description": "dyn-rt dynamic runtime — single publishable TypeScript package facading libs/typescript modules via subpath exports (ADR 0003).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dyn-rt/manipulation": "workspace:*",
    "@dyn-rt/metadatamodel": "workspace:*",
    "@dyn-rt/path": "workspace:*",
    "@dyn-rt/reflect": "workspace:*",
    "@dyn-rt/schema": "workspace:*",
    "@dyn-rt/shared": "workspace:*"
  },
  "devDependencies": {
    "@dyn-rt/test-support": "workspace:*",
    "@types/node": "^25.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "license": "MIT",
  "author": "Declan Joseph <declan.obu@outlook.com>",
  "keywords": [
    "dyn-rt",
    "dynamic-runtime",
    "jsonpath",
    "reflection",
    "schema",
    "metadata-model"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rogonion/dyn-rt.git",
    "directory": "packages/typescript/dyn-rt"
  },
  "bugs": {
    "url": "https://github.com/rogonion/dyn-rt/issues"
  },
  "homepage": "https://github.com/rogonion/dyn-rt",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}
