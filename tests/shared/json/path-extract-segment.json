[
  {
    "name": "standalone root selector",
    "input": "$",
    "expected": {
      "access": "mixed",
      "selector": {
        "kind": "root"
      }
    }
  },
  {
    "name": "standalone property name",
    "input": "store",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "store"
      }
    }
  },
  {
    "name": "standalone wildcard selector",
    "input": "*",
    "expected": {
      "access": "mixed",
      "selector": {
        "kind": "wildcard"
      }
    }
  },
  {
    "name": "quoted bracket key with inner dots",
    "input": "'a..b'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "a..b"
      }
    }
  },
  {
    "name": "hyphenated quoted key",
    "input": "'report-data'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "report-data"
      }
    }
  },
  {
    "name": "complex symbols and dots inside single quotes",
    "input": "'total.sum..()&^'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "total.sum..()&^"
      }
    }
  },
  {
    "name": "slice start:end:step",
    "input": "1:5:2",
    "expected": {
      "access": "positional",
      "selector": {
        "kind": "slice",
        "start": 1,
        "end": 5,
        "step": 2
      }
    }
  },
  {
    "name": "slice start:end",
    "input": "1:5",
    "expected": {
      "access": "positional",
      "selector": {
        "kind": "slice",
        "start": 1,
        "end": 5,
        "step": null
      }
    }
  },
  {
    "name": "slice step only",
    "input": "::-2",
    "expected": {
      "access": "positional",
      "selector": {
        "kind": "slice",
        "start": null,
        "end": null,
        "step": -2
      }
    }
  },
  {
    "name": "slice end:step",
    "input": ":4:-2",
    "expected": {
      "access": "positional",
      "selector": {
        "kind": "slice",
        "start": null,
        "end": 4,
        "step": -2
      }
    }
  },
  {
    "name": "mixed union selector with key, key, index, slice members",
    "input": "'theme-settings',\"font-size\",-3, -1::2",
    "expected": {
      "access": "mixed",
      "selector": {
        "kind": "union",
        "members": [
          {
            "access": "named",
            "selector": {
              "kind": "key",
              "value": "theme-settings"
            }
          },
          {
            "access": "named",
            "selector": {
              "kind": "key",
              "value": "font-size"
            }
          },
          {
            "access": "positional",
            "selector": {
              "kind": "index",
              "value": -3
            }
          },
          {
            "access": "positional",
            "selector": {
              "kind": "slice",
              "start": -1,
              "end": null,
              "step": 2
            }
          }
        ]
      }
    }
  },
  {
    "name": "quoted key with space",
    "input": "'user info'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "user info"
      }
    }
  },
  {
    "name": "escaped quote bracket key",
    "input": "'store\\'s..item'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "store\\'s..item"
      }
    }
  },
  {
    "name": "escaped double quote bracket key",
    "input": "\"user\\\"name..data\"",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "user\\\"name..data"
      }
    }
  },
  {
    "name": "empty string bracket key",
    "input": "''",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": ""
      }
    }
  },
  {
    "name": "mixed quote bracket key",
    "input": "'title_\"main\"..part'",
    "expected": {
      "access": "named",
      "selector": {
        "kind": "key",
        "value": "title_\"main\"..part"
      }
    }
  }
]
