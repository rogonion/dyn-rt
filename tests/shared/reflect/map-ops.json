[
  { "name": "map get existing key", "value": { "a": 1, "b": "x" }, "op": "get", "key": "a", "expected": 1 },
  { "name": "map get missing key", "value": { "a": 1 }, "op": "get", "key": "zz", "expected": null },
  { "name": "map contains existing key", "value": { "a": 1 }, "op": "contains", "key": "a", "expected": true },
  { "name": "map contains missing key", "value": { "a": 1 }, "op": "contains", "key": "zz", "expected": false },
  { "name": "map set new key appends", "value": { "a": 1 }, "op": "set", "key": "b", "set": 2, "expected": { "a": 1, "b": 2 } },
  { "name": "map set existing key replaces in place", "value": { "a": 1, "b": 2 }, "op": "set", "key": "a", "set": 9, "expected": { "a": 9, "b": 2 } },
  { "name": "map delete existing key", "value": { "a": 1, "b": 2 }, "op": "delete", "key": "a", "expected": { "b": 2 } },
  { "name": "map delete missing key errors KeyNotFound", "value": { "a": 1 }, "op": "delete", "key": "zz", "expect_error": "KeyNotFound" },
  { "name": "map keys keep insertion order", "value": { "b": 1, "a": 2 }, "op": "keys", "expected": ["b", "a"] },
  { "name": "map len", "value": { "a": 1, "b": 2 }, "op": "len", "expected": 2 },
  { "name": "map set on a scalar fails", "value": 1, "op": "set", "key": "a", "set": 2, "expect_error": "UnsupportedOperation" },
  { "name": "map get on a sequence fails", "value": [1, 2], "op": "get", "key": "a", "expected": null }
]
