  { "name": "sequence push on a map fails", "value": { "a": 1 }, "op": "push", "set": 20, "expect_error": "UnsupportedOperation" },
  { "name": "sequence get on a scalar", "value": 5, "op": "get", "index": 0, "expected": null }
